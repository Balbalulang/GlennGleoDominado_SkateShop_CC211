<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Skate Shop — skateboards, apparel, wheels, trucks and accessories for every skater.">
  <title>Skate Shop | Ride Your Own Line</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800;900&family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="profile-link" href="#contact" aria-label="Account profile">
        <img src="assets/profile.jpg" alt="Account profile">
      </a>
      <a class="brand-mark" href="#home" aria-label="Skate Shop home">
        <img src="assets/shop-logo.jpg" alt="Skate Shop logo">
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false">☰</button>
      <nav class="main-nav" id="mainNav">
        <a href="#home">Home</a>
        <a href="#about">About Us</a>
        <a href="#products">Products</a>
        <a href="#contact">Contact</a>
      </nav>
      <form class="search-box" id="searchForm" role="search">
        <input id="searchInput" type="search" placeholder="Search products..." aria-label="Search products">
        <button type="submit" aria-label="Search">⌕</button>
      </form>
      <button class="cart-button" id="cartButton" type="button" aria-label="Shopping cart">🛒 <span id="cartCount">0</span></button>
    </div>
  </header>

  <main>
    <section class="hero container" id="home">
      <div class="hero-copy">
        <p class="eyebrow">Find your flow. Own your street.</p>
        <h1>RIDE YOUR<br><span>OWN LINE.</span></h1>
        <p>Gear up, get out there, and make every session count.</p>
        <a class="btn btn-skate" href="#categories">SHOP THE COLLECTION <span>↗</span></a>
      </div>
      <div class="hero-art">
        <div class="hero-ring"></div>
        <img src="assets/profile.jpg" alt="Skater profile artwork" class="hero-profile">
        <div class="hero-stamp">SKATE<br><b>MORE.</b></div>
      </div>
    </section>

    <section class="category-section" id="categories">
      <div class="container">
        <div class="section-heading">
          <div><p class="eyebrow">Browse the shop</p><h2>SHOP BY <span>CATEGORY</span></h2></div>
          <div class="carousel-controls">
            <button type="button" id="scrollLeft" aria-label="Scroll categories left">←</button>
            <button type="button" id="scrollRight" aria-label="Scroll categories right">→</button>
          </div>
        </div>
        <div class="category-track" id="categoryTrack" tabindex="0" aria-label="Draggable product categories">
          <a class="category-card" href="#products" data-category="Decks"><img src="assets/decks-category.jpg" alt="Skateboard decks"><span>Decks <b>↗</b></span></a>
          <a class="category-card" href="#products" data-category="Apparel"><img src="assets/apparel-noah.jpg" alt="Skate apparel hoodie"><span>Apparel <b>↗</b></span></a>
          <a class="category-card" href="#products" data-category="Wheels"><img src="assets/wheels.jpg" alt="Skateboard wheels"><span>Wheels <b>↗</b></span></a>
          <a class="category-card" href="#products" data-category="Trucks"><img src="assets/trucks-venture.jpg" alt="Skateboard trucks"><span>Trucks <b>↗</b></span></a>
          <a class="category-card" href="#products" data-category="Bearings"><img src="assets/bearings.jpg" alt="Skateboard bearings"><span>Bearings <b>↗</b></span></a>
          <a class="category-card" href="#products" data-category="Caps"><img src="assets/caps.jpg" alt="Skate caps"><span>Caps <b>↗</b></span></a>
        </div>
        <p class="drag-hint">DRAG OR SWIPE TO EXPLORE <span>⟷</span></p>
      </div>
    </section>

    <section class="about-section container" id="about">
      <div class="about-photo"><img src="assets/shop-interior.jpg" alt="Inside the Skate Shop"></div>
      <div class="about-copy">
        <p class="eyebrow">A shop built around skate culture</p>
        <h2>MORE THAN A<br><span>SKATE SHOP.</span></h2>
        <p>Welcome to Skate Shop, your home for skateboarding, street culture, and creativity.</p>
        <p>We are passionate about providing skateboarders of all ages and skill levels with quality skateboards, wheels, trucks, apparel, accessories, and other essential gear. Whether you're a beginner learning your first tricks or an experienced skater looking to improve your setup, we're here to support your journey.</p>
        <p>Our goal is to create a friendly and welcoming community where skateboarders can ride, learn, express themselves, and have fun. We believe skateboarding is more than just a sport—it is a lifestyle that encourages confidence, creativity, freedom and friendship.</p>
        <a class="text-link" href="#contact">GET IN TOUCH <span>↗</span></a>
      </div>
    </section>

    <section class="featured-section" id="products">
      <div class="container">
        <div class="section-heading">
          <div><p class="eyebrow">Picked for your next session</p><h2>FEATURED <span>PRODUCTS</span></h2></div>
          <span class="feature-note">GOOD GEAR. GOOD TIMES.</span>
        </div>
        <div class="row g-4" id="productGrid">
          <div class="col-12 col-sm-6 col-lg-3 product-column" data-name="Dark Star Collapse Decks" data-category="Decks">
            <article class="product-card">
              <div class="product-image"><span class="product-tag">DECKS</span><img src="assets/darkstar-deck.webp" alt="Darkstar Collapse skateboard deck"></div>
              <div class="product-info"><h3>Dark Star Collapse</h3><p>Darkstar Deck</p><div class="product-bottom"><strong>₱3,200.00</strong><button class="add-cart" data-product="Dark Star Collapse">ADD TO CART +</button></div></div>
            </article>
          </div>
          <div class="col-12 col-sm-6 col-lg-3 product-column" data-name="Venture Trucks" data-category="Trucks">
            <article class="product-card">
              <div class="product-image"><span class="product-tag">TRUCKS</span><img src="assets/trucks-venture.jpg" alt="Venture skateboard trucks"></div>
              <div class="product-info"><h3>Venture Trucks</h3><p>Classic skateboard trucks</p><div class="product-bottom"><strong>₱2,500.00</strong><button class="add-cart" data-product="Venture Trucks">ADD TO CART +</button></div></div>
            </article>
          </div>
          <div class="col-12 col-sm-6 col-lg-3 product-column" data-name="Noah Hoodie" data-category="Apparel">
            <article class="product-card">
              <div class="product-image"><span class="product-tag">APPAREL</span><img src="assets/apparel-noah.jpg" alt="Noah black skate hoodie"></div>
              <div class="product-info"><h3>Noah Hoodie</h3><p>Skate-inspired apparel</p><div class="product-bottom"><strong>₱2,800.00</strong><button class="add-cart" data-product="Noah Hoodie">ADD TO CART +</button></div></div>
            </article>
          </div>
          <div class="col-12 col-sm-6 col-lg-3 product-column" data-name="Assorted Wheels" data-category="Wheels">
            <article class="product-card">
              <div class="product-image"><span class="product-tag">WHEELS</span><img src="assets/wheels.jpg" alt="Assorted skateboard wheels"></div>
              <div class="product-info"><h3>Assorted Wheels</h3><p>Pick your favorite setup</p><div class="product-bottom"><strong>₱1,200.00</strong><button class="add-cart" data-product="Assorted Wheels">ADD TO CART +</button></div></div>
            </article>
          </div>
        </div>
        <p class="search-empty" id="searchEmpty" hidden>No products match your search. Try another keyword.</p>
      </div>
    </section>

    <section class="contact-section container" id="contact">
      <div class="contact-intro"><p class="eyebrow">Questions, ideas, or just saying hi?</p><h2>LET'S <span>CONNECT.</span></h2><p>We're always happy to talk skateboarding. Send us a message or reach out through our contact details.</p>
        <div class="contact-detail"><span class="detail-icon">☎</span><div><small>CONTACT NUMBER</small><a href="tel:09062686011">09062686011</a></div></div>
        <div class="contact-detail"><span class="detail-icon">✉</span><div><small>EMAIL ADDRESS</small><a href="mailto:hello@skateshop.com">hello@skateshop.com</a></div></div>
        <div class="contact-detail"><span class="detail-icon">f</span><div><small>FOLLOW US</small><a href="#" aria-label="Facebook">Skate Shop on Facebook</a></div></div>
      </div>
      <form class="contact-form" id="contactForm">
        <label for="contactName">Your name</label><input id="contactName" name="name" type="text" placeholder="Name" required>
        <label for="contactEmail">Email address</label><input id="contactEmail" name="email" type="email" placeholder="Email" required>
        <label for="contactMessage">Message</label><textarea id="contactMessage" name="message" rows="5" placeholder="Message..." required></textarea>
        <button class="btn btn-skate w-100" type="submit">SEND MESSAGE ↗</button>
        <p class="form-note" id="formNote" role="status">This demo form will open your email app with your message.</p>
      </form>
    </section>
  </main>

  <footer><div class="container footer-inner"><a href="#home">SKATE SHOP<span>®</span></a><p>KEEP PUSHING. KEEP CREATING.</p><small>© <span id="year"></span> Skate Shop. Ride your own line.</small></div></footer>
  <div class="toast-message" id="toastMessage" role="status" aria-live="polite"></div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="script.js"></script>
</body>
</html>
